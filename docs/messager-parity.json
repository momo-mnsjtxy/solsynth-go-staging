    "method": "POST",
    "route": "/api/chat/{roomId:guid}/sync",
    "auth_order": [
      "CurrentUser required: 401",
      "Room existence: 404",
      "If encrypted or not public, active membership required: 403"
    ],
    "request_fields": [
      "last_sync_timestamp: int64 milliseconds",
      "last_sync_message_id: nullable guid (ignored by this endpoint)",
      "missing_sequences: optional int64[]",
      "missing_sequence_ranges: optional {start_sequence,end_sequence}[]"
    ],
    "selection": [
      "room match",
      "ThreadId null",
      "sequence union when usable normalized selectors remain, otherwise CreatedAt strictly later than timestamp"
    ],
    "order": [
      "RoomSequence ASC",
      "CreatedAt ASC"
    ],
    "limit": 1000,
    "response_fields": [
      "messages",
      "current_timestamp",
      "total_count"
    ],
    "header": "X-Total = total_count",
